# Frontend (Vite) — these values are public by design
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SITE_URL=http://localhost:5173

# Serverless (Vercel / `vercel dev`) — NEVER prefix these with VITE
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Must be the exact secret configured on the Razorpay webhook in the Dashboard.
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
# Optional. Seconds of tolerance for webhook timestamps (default 300).
# RAZORPAY_WEBHOOK_MAX_AGE_SECONDS=300

RESEND_API_KEY=YOUR_RESEND_API_KEY
TICKET_EMAIL_FROM="Orlem Christmas Ball <tickets@orlemchristmasball.in>"

# Optional RSVP (existing)
# VITE_RSVP_WEB3FORMS_KEY=
# VITE_RSVP_FORMSPREE_ID=
